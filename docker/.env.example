# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit the two values at the top.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# REQUIRED: the folder on YOUR machine that holds all data.
# It is created if it does not exist. Use an absolute path.
#   macOS / Linux:  /Users/you/canbiomark-data
#   Windows:        C:/Users/you/canbiomark-data
CANBIOMARK_DATA_DIR=./data

# RECOMMENDED: the first administrator's password.
# Leave it empty and a random one is generated and printed to the log once.
# Minimum 10 characters, at least one letter and one digit.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Everything below has a sensible default and can stay untouched.
# ---------------------------------------------------------------------------

ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator

# Port on your machine. Change it if 8000 is taken.
CANBIOMARK_PORT=8000

# Set to 1 once you serve this over HTTPS behind a reverse proxy.
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_HOURS=12

# Storage per user account, in gigabytes.
DEFAULT_QUOTA_GB=50
# Largest single dataset an administrator may import.
MAX_DATASET_DOWNLOAD_GB=25

# Memory. Keep H2O_MAX_MEMORY clearly below CANBIOMARK_MEMORY_LIMIT: SimBu needs
# room next to the H2O heap. On a 16 GB machine try 8g and 14g.
H2O_MAX_MEMORY=20g
CANBIOMARK_MEMORY_LIMIT=32g

# Seconds before a single SimBu simulation is abandoned.
SIMBU_TIMEOUT_SECONDS=3600

LOG_LEVEL=INFO
